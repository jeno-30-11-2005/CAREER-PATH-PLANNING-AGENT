# Environment Configuration
PROJECT_NAME="Intelligent Career Path Planning Agent"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (Defaults to SQLite for local ease, or PostgreSQL connection string)
DATABASE_URL="sqlite:///./career_agent.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/career_agent_db"

# AI / LLM Configuration (Optional: system works in deterministic mode if key is empty)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
